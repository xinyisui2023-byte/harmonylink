        ['📊', '数据飞轮沉淀', '多积分兑换体系形成数据飞轮，网络效应强'],
        ['🌐', '注意力经济先发生态位', '首个将注意力所有权归还个人的新生态']
      ].map(([icon, title, desc], i) => `
