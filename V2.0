};

function renderPioneerContent(mode) {
  const el = document.getElementById('pioneer-main-content');
  if (!el) return;

  if (mode === 'c') renderPioneerC(el);
  else if (mode === 'b') renderPioneerB(el);
  else if (mode === 'gov') renderPioneerGov(el);
}

